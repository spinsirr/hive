DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
DATABASE_URL_DIRECT=postgresql://user:password@host/database?sslmode=verify-full

# Optional. Hive uses Vercel AI Gateway through Vercel OIDC; no provider key is needed.
HIVE_CODEX_MODEL=openai/gpt-5.1-codex-mini
HIVE_CHAT_MODEL=openai/gpt-5-mini

# Signs links that invite teammates into a task session.
HIVE_INVITE_SECRET=replace_with_a_long_random_value

# GitHub App credentials stay server-side. Never commit the PEM value.
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=hive-multiplayer-agent
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_CLIENT_ID=Iv23example
GITHUB_APP_CLIENT_SECRET=github_app_client_secret
GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/github/callback
